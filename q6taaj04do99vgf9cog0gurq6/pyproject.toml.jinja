######################################################################################################
#                                              metadata                                              #
######################################################################################################
[project]
name = "{{ project_id }}"
version = "0.0.0"

requires-python = ">= {{ minimum_python_version }}"
dependencies = []

authors = [{name = "{{ owner_name }}", email = "{{ owner_email }}"}]

[build-system]
build-backend = "hatchling.build"
requires = ["hatchling"]

[dependency-groups]


######################################################################################################
#                                                pixi                                                #
######################################################################################################
[tool.pixi.workspace]
channels = ["conda-forge"]
platforms = ["win-64", "linux-64"]

[tool.pixi.pypi-dependencies]
{{ project_id }} = { path = ".", editable = true }

# ==================================== defaults ====================================
[tool.pixi.tasks]
    
# ==================================== environments ====================================
# ----------------------------- dev -----------------------------
[tool.pixi.environments.dev]
features = ["dev", "docs"]
solve-group = "default"

# ==================================== features ====================================
# ----------------------------- dev -----------------------------
[tool.pixi.feature.dev.dependencies]
git = ">=2.54.0,<3"
gh = ">=2.83.2,<3"
pyrefly = ">=1.0.0,<2"
ruff = ">=0.14.13,<0.15"
prek = ">=0.2.30,<0.3"
mypy = ">=1.19.1,<2"
nodejs = ">=25.2.1,<25.3"
markdownlint-cli2 = ">=0.20.0,<0.21"

[tool.pixi.feature.dev.tasks]
setup = "prek install"

clean_stubs = "python -c \"import pathlib; [f.unlink() for f in pathlib.Path('$PIXI_PROJECT_NAME').rglob('*.pyi')]\""
generate_stubs = {cmd = "stubgen -p $PIXI_PROJECT_NAME -o . --include-docstrings"}
regenerate_stubs = {depends-on = ["clean_stubs", "generate_stubs"]}

lint_markdown = "npx --yes markdownlint-cli2"
format_markdown = "npx --yes markdownlint-cli2 --fix"
lint_all_markdown = "npx --yes markdownlint-cli2 '**/*.md'"
format_all_markdown = "npx --yes markdownlint-cli2 --fix '**/*.md'"

# ----------------------------- docs -----------------------------
[tool.pixi.feature.docs.dependencies]
mkdocs = ">=1.6.1,<2"
mkdocs-material = ">=9.7.6,<10"
pymdown-extensions = ">=10.20,<11"

[tool.pixi.feature.docs.tasks]
build_docs = "mkdocs build --config-file mkdocs.yaml"

######################################################################################################
#                                                ruff                                                #
######################################################################################################
[tool.ruff]
src = ["."]
exclude = ["node_modules", "venv", ".git", ".pixi"]
line-length = 100
indent-width = 4

[tool.ruff.format]
quote-style = "double"
indent-style = "space"
skip-magic-trailing-comma = false
docstring-code-format = true


######################################################################################################
#                                             pyrefly                                                #
######################################################################################################
[tool.pyrefly]
project-includes = [
    "**/*.py*",
    "**/*.ipynb",
]


